<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ProxyTrafficFloat</AssemblyName>
    <Version>2.1.0</Version>
    <Product>Traffic Lens</Product>
    <Authors>onlielll</Authors>
    <Copyright>Copyright (c) 2026 onlielll</Copyright>
    <ApplicationIcon>..\assets\traffic.ico</ApplicationIcon>
    <ApplicationManifest>..\src\app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="false" />
    <Compile Include="..\src\Core.cs" Link="Core.cs" />
    <Compile Include="..\src\Diagnostics.cs" Link="Diagnostics.cs" />
    <Compile Include="..\src\ResourceTrend.cs" Link="ResourceTrend.cs" Condition="'$(VerificationBuild)' == 'true'" />
    <Compile Include="..\src\Timeline.cs" Link="Timeline.cs" />
    <Compile Include="..\src\AppTheme.cs" Link="AppTheme.cs" />
    <Compile Include="..\src\Storage.cs" Link="Storage.cs" />
    <Compile Include="..\src\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\src\SettingsJson.cs" Link="SettingsJson.cs" />
    <Compile Include="..\src\Transport.cs" Link="Transport.cs" />
    <Compile Include="..\src\PresentationLogic.cs" Link="PresentationLogic.cs" />
    <EmbeddedResource Include="..\assets\traffic.ico" LogicalName="ProxyTrafficFloat.traffic.ico" />
    <EmbeddedResource Include="..\assets\heroicons\glyphs.bin" LogicalName="TrafficLens.ToolbarPaths" />
  <Compile Include="..\src\QuotaForecast.cs" Link="QuotaForecast.cs" /><Compile Include="..\src\NodeLatency.cs" Link="NodeLatency.cs" /></ItemGroup>
  <PropertyGroup Condition="'$(VerificationBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);TRAFFIC_LENS_VERIFICATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(VerificationBuild)' != 'true'">
    <Compile Remove="**/*Tests.cs" />
  </ItemGroup>
</Project>
